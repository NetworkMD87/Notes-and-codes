{
  "name": "notes-and-codes",
  "version": "1.21.0",
  "description": "Notes & Codes — a fast dev scratchpad",
  "author": "NetworkMD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NetworkMD87/Notes-and-codes.git"
  },
  "bugs": {
    "url": "https://github.com/NetworkMD87/Notes-and-codes/issues"
  },
  "homepage": "https://github.com/NetworkMD87/Notes-and-codes#readme",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "typecheck": "tsc --noEmit",
    "preview": "electron-vite preview",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:workspace": "vitest run --config vitest.benchmark.config.ts",
    "test:smoke": "playwright test",
    "make-icon": "node scripts/make-icon.mjs",
    "verify:spell-assets": "node scripts/verifySpellAssets.mjs --app",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.1",
    "typescript": "^5.5.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dompurify": "^3.4.13",
    "markdown-it": "^14.2.0",
    "monaco-editor": "^0.50.0",
    "nspell": "^2.1.5",
    "prettier": "^3.8.4",
    "split.js": "^1.6.5"
  },
  "overrides": {
    "linkify-it": "^5.0.2"
  },
  "allowScripts": {
    "electron@41.10.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
